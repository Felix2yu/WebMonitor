# Stage 1: Build frontend
# node 大版本与仓库根 .nvmrc 一致；pnpm 版本从 frontend/package.json 的 packageManager 解析，
# 不在这里重复写死。原先的 --legacy-peer-deps 已去掉：pnpm 下 MUI 9 / Emotion / React 19 无 peer 冲突。
FROM node:26-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    PNPM=$(node -p "require('./package.json').packageManager.slice(5)") \
 && npm i -g pnpm@$PNPM \
 && pnpm install --frozen-lockfile
COPY frontend/ .
RUN pnpm run build

# Stage 2: Final image (no Chromium — uses external browserless)
FROM python:3.14-slim

WORKDIR /app

# Install minimal system dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libxml2-dev \
    libxslt-dev \
    tzdata

# Install Python dependencies (copy requirements.txt first for better caching)
COPY backend/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Copy backend code
COPY backend/ .

# Copy frontend build output
COPY --from=frontend-build /app/build/ ./frontend-build/

# Create non-root user
RUN useradd -m -u 1000 appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
